<?xml version="1.0" encoding="utf-8"?>
<!--
  SOS Ring — Stile 2A "Indaco"  ·  values/themes.xml (base + CHIARO)
  Sostituisce app/src/main/res/values/themes.xml
  Base Material3 DayNight: i valori di notte arrivano da values-night/ (colors + questo file duplicato).
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SOSRing.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Superfici -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/status_missing</item>

        <!-- Forma: raggi generosi (look "Custode") -->
        <item name="shapeAppearanceCornerSmall">@style/Shape.SOSRing.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.SOSRing.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.SOSRing.Large</item>

        <!-- Tipografia -->
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="Theme.SOSRing.Indaco" parent="Theme.SOSRing.Base">
        <item name="colorPrimary">@color/indaco_primary</item>
        <item name="colorPrimaryContainer">@color/indaco_container</item>
        <item name="colorOnPrimaryContainer">@color/indaco_on_container</item>
        <item name="colorSecondary">@color/indaco_secondary</item>
        <item name="colorSecondaryContainer">@color/indaco_secondary_bg</item>
        <item name="colorTertiary">@color/indaco_accent</item>
        <item name="tokenAccent">@color/indaco_accent</item>
        <item name="tokenFaded">@color/indaco_faded</item>
        <item name="tokenStatusOk">@color/indaco_status_ok</item>
        <item name="tokenHeroBg">@color/indaco_hero_bg</item>
        <item name="tokenHeroChipBg">@color/indaco_hero_chip_bg</item>
    </style>

    <style name="Theme.SOSRing.Teal" parent="Theme.SOSRing.Base">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorPrimaryContainer">@color/teal_container</item>
        <item name="colorOnPrimaryContainer">@color/teal_on_container</item>
        <item name="colorSecondary">@color/teal_secondary</item>
        <item name="colorSecondaryContainer">@color/teal_secondary_bg</item>
        <item name="colorTertiary">@color/teal_accent</item>
        <item name="tokenAccent">@color/teal_accent</item>
        <item name="tokenFaded">@color/teal_faded</item>
        <item name="tokenStatusOk">@color/teal_status_ok</item>
        <item name="tokenHeroBg">@color/teal_hero_bg</item>
        <item name="tokenHeroChipBg">@color/teal_hero_chip_bg</item>
    </style>

    <style name="Theme.SOSRing.Argilla" parent="Theme.SOSRing.Base">
        <item name="colorPrimary">@color/argilla_primary</item>
        <item name="colorPrimaryContainer">@color/argilla_container</item>
        <item name="colorOnPrimaryContainer">@color/argilla_on_container</item>
        <item name="colorSecondary">@color/argilla_secondary</item>
        <item name="colorSecondaryContainer">@color/argilla_secondary_bg</item>
        <item name="colorTertiary">@color/argilla_accent</item>
        <item name="tokenAccent">@color/argilla_accent</item>
        <item name="tokenFaded">@color/argilla_faded</item>
        <item name="tokenStatusOk">@color/argilla_status_ok</item>
        <item name="tokenHeroBg">@color/argilla_hero_bg</item>
        <item name="tokenHeroChipBg">@color/argilla_hero_chip_bg</item>
    </style>

    <style name="Theme.SOSRing.Ardesia" parent="Theme.SOSRing.Base">
        <item name="colorPrimary">@color/ardesia_primary</item>
        <item name="colorPrimaryContainer">@color/ardesia_container</item>
        <item name="colorOnPrimaryContainer">@color/ardesia_on_container</item>
        <item name="colorSecondary">@color/ardesia_secondary</item>
        <item name="colorSecondaryContainer">@color/ardesia_secondary_bg</item>
        <item name="colorTertiary">@color/ardesia_accent</item>
        <item name="tokenAccent">@color/ardesia_accent</item>
        <item name="tokenFaded">@color/ardesia_faded</item>
        <item name="tokenStatusOk">@color/ardesia_status_ok</item>
        <item name="tokenHeroBg">@color/ardesia_hero_bg</item>
        <item name="tokenHeroChipBg">@color/ardesia_hero_chip_bg</item>
    </style>

    <!-- Forme -->
    <style name="Shape.SOSRing.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="Shape.SOSRing.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Shape.SOSRing.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">26dp</item>
    </style>

    <!-- Bottone principale pieno (es. "Attiva", "Esporta") -->
    <style name="Widget.SOSRing.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/tokenAccent</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- FAB indaco -->
    <style name="Widget.SOSRing.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/tokenAccent</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="shapeAppearanceOverlay">@style/Shape.SOSRing.Fab</item>
    </style>
    <style name="Shape.SOSRing.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Card standard -->
    <style name="Widget.SOSRing.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
