<?xml version="1.0" encoding="utf-8"?>
<!--
  SOS Ring — Stile 2A "Indaco"  ·  values/colors.xml (tema CHIARO)
  Sostituisce app/src/main/res/values/colors.xml
  Vale per ENTRAMBI i flavor (family + fdroid): le risorse in src/main sono condivise.
-->
<resources>
    <!-- Brand / primario -->
    <color name="primary">#3D4DB7</color>          <!-- hero, header, azioni principali -->
    <color name="primary_dark">#2F3C99</color>      <!-- status bar / pressed -->
    <color name="primary_accent">#4F5FCB</color>    <!-- FAB, icone accento -->
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#E7E9F8</color> <!-- chip / soft container -->
    <color name="on_primary_container">#2A3599</color>
    <color name="primary_faded">#C7CEF5</color>     <!-- testo/glifi sopra il primario -->

    <!-- Superfici (chiaro) -->
    <color name="bg">#ECEDF3</color>                <!-- sfondo schermata -->
    <color name="surface">#FFFFFF</color>           <!-- card -->
    <color name="surface_alt">#F1F2F8</color>       <!-- riquadri interni -->
    <color name="outline">#E1E3EC</color>           <!-- bordi hairline -->
    <color name="outline_strong">#CDD1E4</color>    <!-- bottoni outlined -->

    <!-- Testo (chiaro) -->
    <color name="ink">#191B24</color>               <!-- titoli / testo primario -->
    <color name="ink_heading">#33374A</color>       <!-- intestazioni sezione -->
    <color name="ink_secondary">#6E7286</color>     <!-- sottotitoli -->
    <color name="ink_muted">#9CA0B4</color>         <!-- disabilitato / chevron -->

    <!-- Semantici (invariati tra chiaro/scuro nella tinta base) -->
    <color name="status_ok">#3D4DB7</color>         <!-- "Concesso" segue il brand indaco -->
    <color name="status_missing">#D85B4B</color>    <!-- errore / permesso mancante -->
    <color name="status_missing_bg">#FBE6E1</color>
    <color name="warning">#C77E1E</color>           <!-- mute / avvisi -->
    <color name="warning_bg">#FBEFDD</color>
    <color name="danger">#D85B4B</color>            <!-- Stop tracking / rimuovi -->

    <!-- Secondario (accento freddo complementare, usato con parsimonia) -->
    <color name="secondary">#6A4FB0</color>
    <color name="secondary_bg">#EEE9F8</color>

    <!-- Launcher -->
    <color name="ic_launcher_background">#3D4DB7</color>

    <!-- Hero e drawer: indaco profondo e contrasto stabile in chiaro/scuro -->
    <color name="hero_bg">#3D4DB7</color>
    <color name="hero_on">#FFFFFF</color>
    <color name="hero_on_muted">#C7CEF5</color>
    <color name="hero_chip_bg">#5C69C2</color>
    <color name="hero_chip_on">#FFFFFF</color>
</resources>
